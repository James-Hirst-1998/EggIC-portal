# Copy to .env for local development. Never commit the real file.
#
# Both URLs are printed by `modal deploy modal/app.py`.
EGGIC_PREDICT_URL=https://<workspace>--eggic-model-predict.modal.run
EGGIC_FEEDBACK_URL=https://<workspace>--eggic-feedback.modal.run

# Must match the value stored in the `eggic-api-key` Modal secret.
EGGIC_API_KEY=

# For scripts/ only. Project Settings -> API Keys. The secret key bypasses
# row-level security: keep it here and in the `eggic-supabase` Modal secret.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
